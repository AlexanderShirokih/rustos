export global Palette {
    out property <color> page: #ffffff;
    out property <color> sidebar: #f6f7f9;
    out property <color> line: #e3e6eb;
    out property <color> text: #1d2330;
    out property <color> muted: #6b7280;
    out property <color> faint: #a3a9b5;
    out property <color> selection: #dbe7fb;
    out property <color> inactive: #e8eaee;
    out property <color> focus: #f3f7fe;
    out property <color> accent: #3b82f6;
}
