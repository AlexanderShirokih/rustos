import "@dejavu/DejaVuSansMono.ttf";
import { Palette } from "palette.slint";

export enum RowKind {
    line,
    gap,
    failure,
}

export enum RowLevel {
    fatal,
    error,
    warn,
    info,
    debug,
}

export struct Row {
    kind: RowKind,
    level: RowLevel,
    kernel: bool,
    time: string,
    source: string,
    text: string,
    wrapped: bool,
}

export component Journal inherits Window {
    in property <[Row]> rows;
    in property <int> source-column;
    in property <int> text-column;
    out property <int> columns: max(1, floor((root.width - 2 * root.margin) / root.advance));

    private property <length> margin: 8px;
    private property <length> advance: probe.preferred-width / 100;
    private property <length> row-height: probe.preferred-height;

    default-font-family: "DejaVu Sans Mono";
    default-font-size: 12px;
    background: Palette.background;

    // Шаг сетки - ширина ста символов. Литерал из обратных апострофов встраивает их глиф,
    // которого нет среди встроенных глифов ASCII, для сообщений паники Rust.
    probe := Text {
        visible: false;
        text: "``````````" + "``````````" + "``````````" + "``````````" + "``````````"
            + "``````````" + "``````````" + "``````````" + "``````````" + "``````````";
    }

    Rectangle {
        x: root.margin;
        y: root.margin;
        width: root.width - 2 * root.margin;
        height: root.height - 2 * root.margin;
        clip: true;

        for row[index] in root.rows: Rectangle {
            x: 0;
            y: parent.height - (root.rows.length - index) * root.row-height;
            width: parent.width;
            height: root.row-height;

            Text {
                x: 0;
                y: 0;
                width: root.source-column * root.advance;
                height: parent.height;
                text: row.time;
                color: Palette.time;
            }

            Text {
                x: root.source-column * root.advance;
                y: 0;
                width: (root.text-column - root.source-column) * root.advance;
                height: parent.height;
                text: row.source;
                color: row.kernel ? Palette.kernel-source : Palette.source;
            }

            Text {
                x: row.wrapped ? 0 : root.text-column * root.advance;
                y: 0;
                width: parent.width - self.x;
                height: parent.height;
                text: row.text;
                color: row.kind == RowKind.gap ? Palette.gap
                    : row.kind == RowKind.failure ? Palette.failure
                    : row.level == RowLevel.fatal ? Palette.fatal
                    : row.level == RowLevel.error ? Palette.error
                    : row.level == RowLevel.warn ? Palette.warn
                    : row.level == RowLevel.debug ? Palette.debug
                    : Palette.text;
            }
        }
    }
}
