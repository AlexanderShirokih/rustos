    out property <color> source: #7d8a99;
    out property <color> kernel-source: #6fb3d2;
    out property <color> text: #d7dde5;
    out property <color> debug: #66707c;
    out property <color> warn: #e5c07b;
    out property <color> error: #ef6f6c;
    out property <color> fatal: #ff5c8a;
    out property <color> gap: #e0b45a;
    out property <color> failure: #ef6f6c;
}
