diff -ruN a/std/src/sys/thread_local/key/molecular.rs b/std/src/sys/thread_local/key/molecular.rs
--- a/std/src/sys/thread_local/key/molecular.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/std/src/sys/thread_local/key/molecular.rs	2026-08-09 21:48:01.621516609 +0000
@@ -0,0 +1,27 @@
+//! Ключи локальных данных потока обслуживает `molecular-rt` поверх `TPIDR_EL0`.
+
+pub type Key = molecular_rt::tls::Key;
+
+#[inline]
+pub fn create(dtor: Option<unsafe extern "C" fn(*mut u8)>) -> Key {
+    let key = molecular_rt::tls::create(dtor);
+    if key == 0 {
+        rtabort!("out of TLS keys");
+    }
+    key
+}
+
+#[inline]
+pub unsafe fn set(key: Key, value: *mut u8) {
+    unsafe { molecular_rt::tls::set(key, value) }
+}
+
+#[inline]
+pub unsafe fn get(key: Key) -> *mut u8 {
+    unsafe { molecular_rt::tls::get(key) }
+}
+
+#[inline]
+pub unsafe fn destroy(key: Key) {
+    unsafe { molecular_rt::tls::destroy(key) }
+}
