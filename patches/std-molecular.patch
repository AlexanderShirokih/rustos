--- a/std/src/sys/random/molecular.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/std/src/sys/random/molecular.rs	2026-08-08 22:48:54.698277207 +0000
@@ -0,0 +1,18 @@
+//! Источника энтропии в системе нет.
+//!
+//! `SystemRng` по контракту `std` отдаёт данные, пригодные для криптографии. Такого источника
+//! у нас пока не существует, поэтому запрос падает, а не возвращает предсказуемый поток под
+//! видом случайного. Ключи хеш-таблиц сеются отдельным генератором: там предсказуемость — это
+//! вопрос устойчивости к HashDoS, а не секретности, и цена молчаливой слабости иная.
+
+pub fn fill_bytes(_bytes: &mut [u8]) {
+    panic!("Molecular OS has no entropy source: SystemRng is unavailable");
+}
+
+pub fn hashmap_random_keys() -> (u64, u64) {
+    let mut seed = [0; 16];
+    molecular_rt::random::fill_bytes(&mut seed);
+    let first = u64::from_ne_bytes(seed[..8].try_into().unwrap());
+    let second = u64::from_ne_bytes(seed[8..].try_into().unwrap());
+    (first, second)
+}
