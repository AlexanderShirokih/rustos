@@ -0,0 +1,27 @@
+//! Ключи локальных данных потока обслуживает `runtime` поверх `TPIDR_EL0`.
+
+pub type Key = runtime::tls::Key;
+
+#[inline]
+pub fn create(dtor: Option<unsafe extern "C" fn(*mut u8)>) -> Key {
+    let key = runtime::tls::create(dtor);
+    if key == 0 {
+        rtabort!("out of TLS keys");
+    }
+    key
+}
+
+#[inline]
+pub unsafe fn set(key: Key, value: *mut u8) {
+    unsafe { runtime::tls::set(key, value) }
+}
+
+#[inline]
+pub unsafe fn get(key: Key) -> *mut u8 {
+    unsafe { runtime::tls::get(key) }
+}
+
+#[inline]
+pub unsafe fn destroy(key: Key) {
+    unsafe { runtime::tls::destroy(key) }
+}
