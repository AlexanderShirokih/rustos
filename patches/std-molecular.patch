diff -ruN a/std/src/sys/stdio/molecular.rs b/std/src/sys/stdio/molecular.rs
--- a/std/src/sys/stdio/molecular.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/std/src/sys/stdio/molecular.rs	2026-08-09 22:09:22.406059918 +0000
@@ -0,0 +1,136 @@
+use molecular_rt::{ipc::wire::IpcError, log};
+
+use crate::io::{self, BorrowedCursor};
+use crate::str;
+
+pub struct Stdin;
+pub struct Stdout;
+pub struct Stderr;
+
+// Журнал ведёт записи, а `core::fmt` пишет форматную строку кусками: у каждого потока свой
+// накопитель, и записью становится напечатанная строка целиком. `Stdout` поверх накопителя
+// ещё и буферизует `std`, `Stderr` идёт сюда напрямую.
+static STDOUT: log::Stream = log::Stream::new();
+static STDERR: log::Stream = log::Stream::new();
+
+impl Stdin {
+    pub const fn new() -> Stdin {
+        Stdin
+    }
+}
+
+// Канал ввода приходит отдельной capability, и стартовый кадр её пока не несёт: чтение
+// сразу отдаёт конец потока.
+impl io::Read for Stdin {
+    fn read(&mut self, _buf: &mut [u8]) -> io::Result<usize> {
+        Ok(0)
+    }
+
+    fn read_buf(&mut self, _cursor: BorrowedCursor<'_, u8>) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+impl Stdout {
+    pub const fn new() -> Stdout {
+        Stdout
+    }
+}
+
+impl io::Write for Stdout {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        write_to(&STDOUT, buf)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        STDOUT.flush().map_err(map_ipc_error)
+    }
+}
+
+impl Stderr {
+    pub const fn new() -> Stderr {
+        Stderr
+    }
+}
+
+impl io::Write for Stderr {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        write_to(&STDERR, buf)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        STDERR.flush().map_err(map_ipc_error)
+    }
+}
+
+/// Вывод паники: идёт мимо накопителей потоков.
+///
+/// Накопитель берёт лок, а паника случается и под ним. Сообщение паники ценнее целой строки,
+/// поэтому оно уходит в журнал прямой записью.
+pub struct PanicOutput;
+
+impl io::Write for PanicOutput {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        let text = valid_prefix(buf)?;
+        log::write(text).map_err(map_ipc_error)?;
+        Ok(text.len())
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+fn write_to(stream: &log::Stream, buf: &[u8]) -> io::Result<usize> {
+    let text = valid_prefix(buf)?;
+    stream.write(text).map_err(map_ipc_error)?;
+    Ok(text.len())
+}
+
+// Журнал несёт UTF-8. Оборванная на границе буфера последовательность уходит коротким
+// счётчиком: её остаток придёт следующим вызовом.
+fn valid_prefix(buf: &[u8]) -> io::Result<&str> {
+    match str::from_utf8(buf) {
+        Ok(text) => Ok(text),
+        Err(error) if error.valid_up_to() > 0 => Ok(str::from_utf8(&buf[..error.valid_up_to()])
+            .expect("prefix up to the error is valid UTF-8")),
+        Err(_) => Err(io::const_error!(
+            io::ErrorKind::InvalidData,
+            "stream did not contain valid UTF-8",
+        )),
+    }
+}
+
+fn map_ipc_error(error: IpcError) -> io::Error {
+    let kind = match error {
+        IpcError::PeerClosed | IpcError::SenderGone => io::ErrorKind::BrokenPipe,
+        IpcError::WouldBlock => io::ErrorKind::WouldBlock,
+        IpcError::Timeout => io::ErrorKind::TimedOut,
+        IpcError::ResourceExhausted | IpcError::TooManyHandles => io::ErrorKind::QuotaExceeded,
+        IpcError::FrameOverflow => io::ErrorKind::InvalidInput,
+        IpcError::Truncated
+        | IpcError::FieldOrder
+        | IpcError::MissingField
+        | IpcError::InvalidValue => io::ErrorKind::InvalidData,
+    };
+    io::Error::from(kind)
+}
+
+pub const STDIN_BUF_SIZE: usize = 0;
+
+pub fn is_ebadf(_err: &io::Error) -> bool {
+    true
+}
+
+pub fn panic_output() -> Option<impl io::Write> {
+    Some(PanicOutput)
+}
+
+/// Отдаёт журналу незавершённые строки обоих потоков.
+///
+/// Зовётся на остановке рантайма: `std` выталкивает свой буфер `stdout`, а `stderr` держит
+/// незавершённую строку только здесь.
+pub fn flush_streams() {
+    let _ = STDERR.flush();
+    let _ = STDOUT.flush();
+}
