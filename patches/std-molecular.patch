diff -ruN a/std/src/os/molecular/mod.rs b/std/src/os/molecular/mod.rs
--- a/std/src/os/molecular/mod.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/std/src/os/molecular/mod.rs	2026-08-09 21:48:01.621019477 +0000
@@ -0,0 +1,58 @@
+//! Molecular OS specific definitions.
+//!
+//! Процесс получает ресурсы системы стартовым набором capability, который композиция выдаёт
+//! ему при запуске. Лог-сессию из набора забирает сама библиотека: по ней идут `stdout` и
+//! `stderr`. Остальное - control- и service-порты компонента и слоты его плана - принадлежит
+//! программе и выдаётся ей здесь.
+//!
+//! Capability названы сырым идентификатором: типизированные обёртки над ним и контракты IPC
+//! живут в крейтах userspace, и программа берёт их своей зависимостью. Внутри библиотеки те же
+//! крейты собраны отдельной копией - как `libc` внутри `std` на Unix, - и её типы наружу не
+//! выходят.
+
+#![unstable(feature = "molecular_ext", issue = "none")]
+
+use crate::num::NonZeroU32;
+
+/// Граница числа слотов capability одного компонента.
+pub const SLOT_MAX: usize = molecular_rt::component_abi::COMPONENT_SLOT_MAX;
+
+/// Идентификатор capability в таблице handle процесса.
+pub type RawHandle = NonZeroU32;
+
+/// Стартовый набор capability компонента композиции.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Startup {
+    control: RawHandle,
+    service: RawHandle,
+    slots: [Option<RawHandle>; SLOT_MAX],
+}
+
+impl Startup {
+    /// Серверная сторона control-порта: его клиентскую сторону держит supervisor.
+    pub fn control(&self) -> RawHandle {
+        self.control
+    }
+
+    /// Серверная сторона service-порта: его сессии supervisor минтит клиентам компонента.
+    pub fn service(&self) -> RawHandle {
+        self.service
+    }
+
+    /// Capability слотов в порядке, в котором их объявил манифест компонента.
+    pub fn slots(&self) -> impl Iterator<Item = RawHandle> {
+        self.slots.into_iter().map_while(|slot| slot)
+    }
+}
+
+/// Стартовый набор, который композиция выдала процессу.
+///
+/// `None` - процесс запущен вне композиции, и набора ему никто не слал.
+pub fn startup() -> Option<Startup> {
+    let started = molecular_rt::startup()?;
+    let mut slots = [None; SLOT_MAX];
+    for (place, slot) in slots.iter_mut().zip(started.slots()) {
+        *place = Some(slot.raw());
+    }
+    Some(Startup { control: started.control.raw(), service: started.service.raw(), slots })
+}
