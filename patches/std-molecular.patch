diff -ruN '--exclude=Cargo.lock' a/std/src/sys/pal/molecular/mod.rs b/std/src/sys/pal/molecular/mod.rs
--- a/std/src/sys/pal/molecular/mod.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/std/src/sys/pal/molecular/mod.rs	2026-08-08 23:02:12.095971338 +0000
@@ -0,0 +1,53 @@
+//! Платформенный слой Molecular OS.
+//!
+//! Работу выполняет крейт `molecular-rt`: он же обслуживает userspace-программы вне `std`.
+//! Здесь только точка входа и перенос futex наружу, где его ждут реализации синхронизации.
+
+#![allow(unsafe_op_in_unsafe_fn)]
+
+pub use molecular_rt::futex;
+
+use crate::io;
+
+/// Точка входа программы: ядро передаёт handle стартового порта в `x0`.
+#[cfg(not(test))]
+#[unsafe(no_mangle)]
+pub extern "C" fn _start(bootstrap: u32) -> ! {
+    molecular_rt::start(bootstrap);
+
+    unsafe extern "C" {
+        fn main(argc: isize, argv: *const *const u8, sigpipe: u8) -> i32;
+    }
+    // Аргументов командной строки процесс пока не получает: ядро их не передаёт.
+    let code = unsafe { main(0, crate::ptr::null(), 0) };
+
+    molecular_rt::exit(code)
+}
+
+/// # Safety
+///
+/// Вызывается один раз при инициализации рантайма.
+pub unsafe fn init(_argc: isize, _argv: *const *const u8, _sigpipe: u8) {}
+
+/// # Safety
+///
+/// Вызывается один раз при остановке рантайма и не гарантирован при аварийном завершении.
+pub unsafe fn cleanup() {
+    // Ключевой TLS рассчитывает, что деструкторы ключей гоняет платформа на выходе потока.
+    // Для главного потока этот выход здесь: `rt::cleanup` зовут и возврат из `main`, и
+    // `process::exit`. Без этого не отработали бы ни `Drop` у `thread_local!`, ни
+    // `rt::thread_cleanup`.
+    molecular_rt::tls::run_destructors();
+}
+
+pub fn unsupported<T>() -> io::Result<T> {
+    Err(unsupported_err())
+}
+
+pub fn unsupported_err() -> io::Error {
+    io::Error::UNSUPPORTED_PLATFORM
+}
+
+pub fn abort_internal() -> ! {
+    molecular_rt::exit(-1)
+}
