diff -ruN a/std/src/sys/thread/molecular.rs b/std/src/sys/thread/molecular.rs
--- a/std/src/sys/thread/molecular.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/std/src/sys/thread/molecular.rs	2026-08-10 19:14:46.640556524 +0000
@@ -0,0 +1,98 @@
+use crate::io;
+use crate::ptr::NonNull;
+use crate::thread::ThreadInit;
+use crate::time::Duration;
+use crate::cmp;
+
+use runtime::thread::{create, release_stack};
+use syscall_user::syscall::{Handle, Priority, SIGNALED, Timeout};
+
+/// Приоритет потока: тот же, с каким userspace поднимает свои рабочие потоки.
+const PRIORITY: Priority = Priority::new(1);
+
+pub const DEFAULT_MIN_STACK_SIZE: usize = 256 * 1024;
+
+/// Запущенный поток: его handle и стек, выделенный кучей процесса.
+///
+/// `join` освобождает стек. Поток, брошенный без `join`, остаётся отвязанным, и стек с ним:
+/// на нём поток ещё может исполняться.
+pub struct Thread {
+    handle: Handle,
+    stack: NonNull<u8>,
+    stack_bytes: usize,
+}
+
+// SAFETY: поля описывают чужой поток и его стек, и владение ими переносится целиком.
+unsafe impl Send for Thread {}
+// SAFETY: см. impl Send.
+unsafe impl Sync for Thread {}
+
+impl Thread {
+    // unsafe: see thread::Builder::spawn_unchecked for safety requirements
+    pub unsafe fn new(stack: usize, init: Box<ThreadInit>) -> io::Result<Thread> {
+        let payload = Box::into_raw(init);
+        let started = create(
+            start,
+            payload as usize,
+            cmp::max(stack, DEFAULT_MIN_STACK_SIZE),
+            PRIORITY,
+        );
+
+        match started {
+            Ok(spawned) => Ok(Thread {
+                handle: spawned.thread(),
+                stack: spawned.stack(),
+                stack_bytes: spawned.stack_bytes(),
+            }),
+            Err(error) => {
+                // Поток не стартовал: точку входа его аргумент не прочитает.
+                // SAFETY: указатель только что из `Box::into_raw`, других владельцев нет.
+                drop(unsafe { Box::from_raw(payload) });
+                Err(io::Error::from_raw_os_error(error as i32))
+            }
+        }
+    }
+
+    pub fn join(self) {
+        let outcome = syscall_user::signal_wait_one(self.handle, SIGNALED, Timeout::INFINITE);
+        assert!(outcome >= 0, "failed to join thread");
+        // SAFETY: поток терминирован, и его стек больше никем не адресуется. Указатель и
+        // размер - те же, с какими стек выдан запуском.
+        unsafe { release_stack(self.stack, self.stack_bytes) };
+        syscall_user::handle_close(self.handle);
+    }
+}
+
+extern "C" fn start(payload: usize) -> ! {
+    // SAFETY: аргумент пришёл из `Box::into_raw` в `Thread::new` и разбирается ровно один
+    // раз: этот поток - его единственный владелец.
+    let init = unsafe { Box::from_raw(payload as *mut ThreadInit) };
+    let rust_start = init.init();
+    rust_start();
+
+    // Уход потока - последний момент, когда его локальные данные ещё адресуемы.
+    runtime::tls::run_destructors();
+    crate::rt::thread_cleanup();
+    syscall_user::thread_exit(0)
+}
+
+pub fn yield_now() {
+    syscall_user::thread_yield();
+}
+
+pub fn sleep(dur: Duration) {
+    // Адрес futex локален вызову, и разбудить по нему некому: ожидание истекает сроком.
+    // Ложное пробуждение возвращает управление раньше, поэтому срок досчитывается.
+    let idle = runtime::Futex::new(0);
+    let started = runtime::Instant::now();
+    let mut remaining = dur;
+    while runtime::futex_wait(&idle, 0, Some(remaining)) {
+        let elapsed = Duration::from_nanos(runtime::Instant::now().as_nanos().wrapping_sub(
+            started.as_nanos(),
+        ));
+        let Some(left) = dur.checked_sub(elapsed) else {
+            return;
+        };
+        remaining = left;
+    }
+}
diff -ruN a/std/src/sys/thread_local/key/molecular.rs b/std/src/sys/thread_local/key/molecular.rs
--- a/std/src/sys/thread_local/key/molecular.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/std/src/sys/thread_local/key/molecular.rs	2026-08-10 18:37:47.249583975 +0000
@@ -0,0 +1,27 @@
+//! Ключи локальных данных потока обслуживает `runtime` поверх `TPIDR_EL0`.
+
+pub type Key = runtime::tls::Key;
+
+#[inline]
+pub fn create(dtor: Option<unsafe extern "C" fn(*mut u8)>) -> Key {
+    let key = runtime::tls::create(dtor);
+    if key == 0 {
+        rtabort!("out of TLS keys");
+    }
+    key
+}
+
+#[inline]
+pub unsafe fn set(key: Key, value: *mut u8) {
+    unsafe { runtime::tls::set(key, value) }
+}
+
+#[inline]
+pub unsafe fn get(key: Key) -> *mut u8 {
+    unsafe { runtime::tls::get(key) }
+}
+
+#[inline]
+pub unsafe fn destroy(key: Key) {
+    unsafe { runtime::tls::destroy(key) }
+}
