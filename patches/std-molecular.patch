diff -ruN a/std/src/os/molecular/mod.rs b/std/src/os/molecular/mod.rs
--- a/std/src/os/molecular/mod.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/std/src/os/molecular/mod.rs	2026-08-10 18:37:47.249314886 +0000
@@ -0,0 +1,82 @@
+//! RustOS-specific definitions.
+//!
+//! Процесс получает ресурсы системы стартовым набором capability, который композиция выдаёт
+//! ему одноразовым портом при запуске. Серверную сторону порта ядро кладёт в точку входа, и
+//! библиотека отдаёт её программе один раз владеющим значением: набор принимает и разбирает
+//! сама программа крейтами userspace.
+//!
+//! Корню композиции набора не выдают: по тому же handle у него остаётся обращение к ядру.
+//!
+//! Лог-сессию набора программа возвращает библиотеке: по ней идут `stdout` и `stderr`.
+//!
+//! Типизированные обёртки над capability и контракты IPC живут в крейтах userspace, и
+//! программа берёт их своей зависимостью. Внутри библиотеки те же крейты собраны отдельной
+//! копией - как `libc` внутри `std` на Unix, - и её типы наружу не выходят.
+
+#![unstable(feature = "molecular_ext", issue = "none")]
+
+use crate::num::NonZeroU32;
+
+use syscall_user::IssuedHandle;
+use syscall_user::syscall::kind;
+
+/// Идентификатор capability в таблице handle процесса.
+pub type RawHandle = NonZeroU32;
+
+/// Владеет capability процесса. Разрушение владельца закрывает её.
+#[derive(Debug)]
+pub struct OwnedHandle {
+    handle: IssuedHandle<kind::Any>,
+}
+
+impl OwnedHandle {
+    /// Идентификатор владеемой capability.
+    pub fn as_raw(&self) -> RawHandle {
+        self.handle.as_raw().as_nonzero()
+    }
+
+    /// Оставляет capability процессу до его завершения и отдаёт её идентификатор. Запись
+    /// закрывает ядро при завершении процесса.
+    pub fn leak(self) -> RawHandle {
+        self.handle.leak().as_nonzero()
+    }
+
+    /// Владелец записи таблицы handle процесса по её идентификатору.
+    ///
+    /// # Safety
+    ///
+    /// `raw` называет открытую запись без другого владельца: её идентификатор отдал
+    /// [`OwnedHandle::leak`] либо владелец вне библиотеки, который от записи отказался.
+    pub unsafe fn from_raw(raw: RawHandle) -> Self {
+        // SAFETY: условие вызова `from_raw` совпадает с условием `adopt`.
+        Self { handle: unsafe { IssuedHandle::adopt(raw) } }
+    }
+
+    pub(crate) fn into_issued(self) -> IssuedHandle<kind::Any> {
+        self.handle
+    }
+}
+
+/// Стартовый handle, положенный ядром в точку входа процесса.
+///
+/// Владение уходит вызывающему, и выдача одна: дальше `None`. `None` на первом вызове -
+/// процесс запущен без стартового handle.
+pub fn take_start_handle() -> Option<OwnedHandle> {
+    Some(OwnedHandle { handle: runtime::take_bootstrap()? })
+}
+
+/// Делает сессию маршрутизатора имён файловым корнем процесса. Пути `std::fs` отсчитываются
+/// от области этой сессии, а до установки операции по пути отвечают `NotConnected`.
+/// Установленный корень не заменяется, и повторный вызов возвращает `root` в `Err`.
+pub fn install_filesystem_root(root: OwnedHandle) -> Result<(), OwnedHandle> {
+    crate::sys::fs::install_root(root)
+}
+
+/// Направляет `stdout` и `stderr` процесса в лог-сессию `session`.
+///
+/// Сессию приносит стартовый набор компонента, и до установки вывод уходит в никуда. Имя
+/// источника остаётся за значком сессии. Повторная установка сохраняет первую сессию и
+/// закрывает переданную.
+pub fn install_log(session: OwnedHandle) {
+    runtime::install_log(session.into_issued().assume_kind());
+}
