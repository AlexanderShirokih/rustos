diff -ruN '--exclude=Cargo.lock' a/std/src/sys/io/error/molecular.rs b/std/src/sys/io/error/molecular.rs
--- a/std/src/sys/io/error/molecular.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/std/src/sys/io/error/molecular.rs	2026-08-08 23:02:33.551970719 +0000
@@ -0,0 +1,75 @@
+//! Отображение ошибок syscall-ABI в `io::ErrorKind`.
+//!
+//! Перечисление берётся из крейта ABI через `molecular-rt`, а не переписывается числами:
+//! новый вариант ломает сборку здесь, а не молча уезжает в `Uncategorized`.
+
+use molecular_rt::syscall::SyscallError;
+
+use crate::io::ErrorKind;
+
+/// Глобального «последнего errno» в ABI нет: каждый syscall возвращает свой код.
+pub fn errno() -> i32 {
+    0
+}
+
+/// Повторяемых кодов в ABI нет: `Canceled` означает исчезнувший handle, и повтор его не вернёт.
+pub fn is_interrupted(_code: i32) -> bool {
+    false
+}
+
+pub fn decode_error_kind(code: i32) -> ErrorKind {
+    let Ok(code) = u32::try_from(code) else {
+        return ErrorKind::Uncategorized;
+    };
+    let Some(error) = SyscallError::from_code(code) else {
+        return ErrorKind::Uncategorized;
+    };
+    match error {
+        SyscallError::BadSyscall | SyscallError::KernelOriginated => ErrorKind::Unsupported,
+        SyscallError::InvalidArgument
+        | SyscallError::WrongType
+        | SyscallError::BufferTooSmall
+        | SyscallError::MessageTooBig => ErrorKind::InvalidInput,
+        SyscallError::BadHandle | SyscallError::Revoked => ErrorKind::InvalidData,
+        SyscallError::AccessDenied => ErrorKind::PermissionDenied,
+        SyscallError::ShouldWait => ErrorKind::WouldBlock,
+        // Ожидание сорвал уход парной стороны или самого handle: повторять нечего.
+        SyscallError::PeerClosed | SyscallError::SenderGone | SyscallError::Canceled => {
+            ErrorKind::BrokenPipe
+        }
+        SyscallError::Timeout => ErrorKind::TimedOut,
+        SyscallError::OutOfHandles
+        | SyscallError::OutOfMemory
+        | SyscallError::ResourceExhausted => ErrorKind::OutOfMemory,
+        SyscallError::NotFound => ErrorKind::NotFound,
+        SyscallError::AlreadyBound => ErrorKind::AlreadyExists,
+    }
+}
+
+pub fn error_string(errno: i32) -> String {
+    let text = u32::try_from(errno)
+        .ok()
+        .and_then(SyscallError::from_code)
+        .map_or("unknown error", |error| match error {
+            SyscallError::BadSyscall => "unknown syscall number",
+            SyscallError::KernelOriginated => "syscall issued from kernel context",
+            SyscallError::InvalidArgument => "invalid argument",
+            SyscallError::BadHandle => "invalid or closed handle",
+            SyscallError::WrongType => "handle refers to an object of another type",
+            SyscallError::AccessDenied => "handle lacks the required rights",
+            SyscallError::ShouldWait => "operation must be retried later",
+            SyscallError::PeerClosed => "peer port is closed",
+            SyscallError::Timeout => "deadline expired",
+            SyscallError::BufferTooSmall => "receive buffer is smaller than the message",
+            SyscallError::MessageTooBig => "message exceeds the size limit",
+            SyscallError::OutOfHandles => "capability table is exhausted",
+            SyscallError::OutOfMemory => "out of memory",
+            SyscallError::NotFound => "region is not in the process registry",
+            SyscallError::Canceled => "wait was canceled",
+            SyscallError::ResourceExhausted => "resource accounting is exhausted",
+            SyscallError::Revoked => "capability was revoked",
+            SyscallError::AlreadyBound => "interrupt line is already bound",
+            SyscallError::SenderGone => "all badge senders are gone",
+        });
+    text.to_string()
+}
